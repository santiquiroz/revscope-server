# Password de Postgres (docker-compose lo pasa al contenedor db y a la URL del api)
POSTGRES_PASSWORD=cambiame

# none  = sin auth (LAN / grupo de confianza)
# token = un Bearer token compartido (defínelo en AUTH_TOKEN)
# oidc  = valida JWT de cualquier issuer OpenID Connect
AUTH_MODE=none
AUTH_TOKEN=
OIDC_ISSUER=
OIDC_AUDIENCE=revscope
